{
  "name": "enlumine-workspace",
  "version": "0.0.0",
  "description": "A syntax highlighter for terminals",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs && node scripts/check-bundle-sizes.mjs",
    "test:highlight-lines": "pnpm build && node --test test/highlight-lines.test.mjs",
    "test:compatibility": "pnpm build && node --test test/compatibility.test.mjs test/json.test.mjs test/sql.test.mjs test/graphql-lexical.test.mjs",
    "smoke:packages": "pnpm build && node scripts/smoke-packages.mjs",
    "size": "pnpm build && node scripts/size.mjs",
    "size:check": "pnpm build && node scripts/check-bundle-sizes.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only --ignore-scripts",
    "release": "pnpm build && changeset publish",
    "bootstrap:publish": "pnpm build && node scripts/bootstrap-publish.mjs",
    "trust:configure": "node scripts/configure-trusted-publishing.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toiroakr/enlumine.git"
  },
  "devDependencies": {
    "@twinkleplop/core": "0.3.1",
    "@twinkleplop/css": "0.1.7",
    "@twinkleplop/graphql": "0.2.1",
    "@twinkleplop/html": "0.1.7",
    "@twinkleplop/javascript": "0.1.7",
    "@twinkleplop/json": "0.1.7",
    "@twinkleplop/sql": "0.1.7",
    "@twinkleplop/typescript": "0.1.7",
    "@types/node": "^22.0.0",
    "esbuild": "0.28.2",
    "graphql": "17.0.2",
    "terser": "5.51.2",
    "typescript": "^5.9.0",
    "@changesets/cli": "3.0.3"
  },
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "license": "MIT"
}
